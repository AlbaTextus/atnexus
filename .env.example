APP_ENV=development
HTTP_ADDR=:8001
ATHUB_HTTP_ADDR=:8005
CREATPLAT_HTTP_ADDR=:8004
IMAGE_HTTP_ADDR=:8002
# Independent image database in your existing PostgreSQL instance.
IMAGE_DATABASE_URL=
# Existing directory containing image bytes; startup refuses a missing root.
IMAGE_LOCAL_ROOT=
IMAGE_TEMP_ROOT=temp/image
IMAGE_PUBLIC_URL=http://localhost:8002
# Optional file-only listener for existing /file links, e.g. 127.0.0.1:8082.
IMAGE_LEGACY_HTTP_ADDR=
# Read-only SQLite source for the one-time Go migration command.
IMAGE_LEGACY_SQLITE=
IMAGE_MAX_UPLOAD_BYTES=536870912
IMAGE_MAX_CHUNK_BYTES=20971520
IMAGE_MAX_CHUNKS=1000
IMAGE_UPLOAD_TTL=24h
IMAGE_HTTP_TIMEOUT=10m
# Unfinished chunked uploads one account or key may hold open.
IMAGE_MAX_UPLOAD_SESSIONS=20
# Image metadata pool size; 0 keeps pool_max_conns from the URL, else 10.
IMAGE_DATABASE_MAX_CONNS=0
# Compose uses an external PG connection and an existing bind-mounted directory.
IMAGE_COMPOSE_DATABASE_URL=
IMAGE_COMPOSE_LOCAL_ROOT=
# Required independent creator PostgreSQL database; never falls back to DATABASE_URL.
CREATPLAT_DATABASE_URL=
# Full legacy review/history verification has a separate startup deadline.
CREATPLAT_MIGRATION_CHECK_TIMEOUT=10m
# Docker Compose: configure creator credentials and its in-network DSN.
CREATPLAT_POSTGRES_USER=creatplat
CREATPLAT_POSTGRES_DB=creatplat
CREATPLAT_POSTGRES_PASSWORD=
CREATPLAT_COMPOSE_DATABASE_URL=
# Comma-separated CIDRs of reverse proxies allowed to supply X-Forwarded-For.
# Add your ingress proxy ranges when it does not connect over loopback.
TRUSTED_PROXY_CIDRS=127.0.0.1/32,::1/128
DATABASE_URL=postgresql://oauth:oauth@localhost:5432/oauth?sslmode=disable
# v2 content database. User API keys and request accounting live in DATABASE_URL.
ATHUB_DATABASE_URL=postgresql://athub:athub@localhost:5433/athub?sslmode=disable
# Optional Redis session cache. Disabled means the server never connects to Redis.
REDIS_ENABLED=false
REDIS_URL=redis://localhost:6379/0
REDIS_KEY_PREFIX=albatextus:connect
REDIS_SESSION_TTL=30s
# Public same-origin entry point, including the Next.js login UI.
ISSUER_URL=http://localhost:3288
AUTH_UI_URL=http://localhost:3288
COOKIE_SECURE=false
SESSION_TTL=24h
# Failed password logins allowed per address and email within the window;
# each email allows 3x and each address 5x across all pairs. 0 disables.
LOGIN_FAILURE_LIMIT=10
LOGIN_FAILURE_WINDOW=15m
AUTHORIZATION_CODE_TTL=5m
HTTP_REQUEST_TIMEOUT=15s
HTTP_SHUTDOWN_TIMEOUT=10s
BCRYPT_COST=12
# Generate once: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Keep this key stable and back it up with your deployment secrets.
CLIENT_SECRET_ENCRYPTION_KEY=
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME=ALBATEXTUS
WEBAUTHN_RP_ORIGINS=http://localhost:3288
PASSKEY_CHALLENGE_TTL=5m

# SMTP 邮箱验证码。HOST/USER/PASS 留空时暂停邮箱注册和验证。
# QQ 邮箱使用 SMTP 授权码，不是 QQ 登录密码。
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# 可选：留空默认使用 SMTP_USER。
SMTP_FROM=
# 587 使用 STARTTLS；465 自动使用 TLS。可按服务商要求显式设置。
# SMTP_SECURE=false

# Cloudflare Turnstile; both keys empty disables verification.
# The public site key is served at /api/v1/auth/verification. Secret stays on Go.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Official test keys require true; test mode is forbidden with APP_ENV=production.
TURNSTILE_TEST_MODE=false
# Exact comma-separated hostnames; empty defaults to the hostname of AUTH_UI_URL.
TURNSTILE_ALLOWED_HOSTNAMES=

# Third-party login (leave both credentials empty to keep the provider disabled).
# GitHub callback: http://localhost:3288/api/v1/auth/providers/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# LINUX DO Connect callback: http://localhost:3288/api/v1/auth/providers/linuxdo/callback
LINUXDO_CLIENT_ID=
LINUXDO_CLIENT_SECRET=
# Generic OAuth 2.0 authorization-code provider with S256 PKCE and JSON userinfo.
# Custom callback: http://localhost:3288/api/v1/auth/providers/custom/callback
CUSTOM_OAUTH_NAME=其他账号
CUSTOM_OAUTH_CLIENT_ID=
CUSTOM_OAUTH_CLIENT_SECRET=
CUSTOM_OAUTH_AUTHORIZATION_URL=
CUSTOM_OAUTH_TOKEN_URL=
CUSTOM_OAUTH_USERINFO_URL=
CUSTOM_OAUTH_SCOPES=openid,profile,email
CUSTOM_OAUTH_SUBJECT_FIELD=sub
CUSTOM_OAUTH_EMAIL_FIELD=email
CUSTOM_OAUTH_EMAIL_VERIFIED_FIELD=email_verified
CUSTOM_OAUTH_NAME_FIELD=name
CUSTOM_OAUTH_AVATAR_FIELD=picture

# Public address of the standalone Wiki service, used by the Next.js frontend.
# Inlined at build time; rebuild the frontend after changing it.
NEXT_PUBLIC_WIKI_URL=http://localhost:3200
