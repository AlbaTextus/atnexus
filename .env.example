APP_ENV=development
HTTP_ADDR=:8080
DATABASE_URL=postgresql://oauth:oauth@localhost:5432/oauth?sslmode=disable
# Public same-origin entry point, including the Next.js login UI.
ISSUER_URL=http://localhost:3000
AUTH_UI_URL=http://localhost:3000
COOKIE_SECURE=false
SESSION_TTL=24h
AUTHORIZATION_CODE_TTL=5m
HTTP_REQUEST_TIMEOUT=15s
HTTP_SHUTDOWN_TIMEOUT=10s
BCRYPT_COST=12
# Generate once: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Keep this key stable and back it up with your deployment secrets.
CLIENT_SECRET_ENCRYPTION_KEY=
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME=AlbaTextus
WEBAUTHN_RP_ORIGINS=http://localhost:3000
PASSKEY_CHALLENGE_TTL=5m

# Cloudflare Turnstile; both keys empty disables verification.
# The public site key is served at /api/v1/auth/verification. Secret stays on Go.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Official test keys require true; test mode is forbidden with APP_ENV=production.
TURNSTILE_TEST_MODE=false
# Exact comma-separated hostnames; empty defaults to the hostname of AUTH_UI_URL.
TURNSTILE_ALLOWED_HOSTNAMES=

# Third-party login (leave both credentials empty to keep the provider disabled).
# GitHub callback: http://localhost:3000/api/v1/auth/providers/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# LINUX DO Connect callback: http://localhost:3000/api/v1/auth/providers/linuxdo/callback
LINUXDO_CLIENT_ID=
LINUXDO_CLIENT_SECRET=
# Generic OAuth 2.0 authorization-code provider with S256 PKCE and JSON userinfo.
# Custom callback: http://localhost:3000/api/v1/auth/providers/custom/callback
CUSTOM_OAUTH_NAME=其他账号
CUSTOM_OAUTH_CLIENT_ID=
CUSTOM_OAUTH_CLIENT_SECRET=
CUSTOM_OAUTH_AUTHORIZATION_URL=
CUSTOM_OAUTH_TOKEN_URL=
CUSTOM_OAUTH_USERINFO_URL=
CUSTOM_OAUTH_SCOPES=openid,profile,email
CUSTOM_OAUTH_SUBJECT_FIELD=sub
CUSTOM_OAUTH_EMAIL_FIELD=email
CUSTOM_OAUTH_EMAIL_VERIFIED_FIELD=email_verified
CUSTOM_OAUTH_NAME_FIELD=name
CUSTOM_OAUTH_AVATAR_FIELD=picture
