generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum NovelStatus {
  ONGOING
  COMPLETED
  ABANDONED
}

model MutationReceipt {
  id String @id @db.Uuid
  response Json
  createdAt DateTime @default(now()) @db.Timestamptz(3)
}

model Platform {
  id      Int      @id @default(autoincrement())
  name    String
  url     String?
  authors Author[]
  novels  Novel[]
}

model Author {
  id         Int      @id @default(autoincrement())
  platformId Int
  name       String?  @db.VarChar(200)
  platform   Platform @relation(fields: [platformId], references: [id], onDelete: Restrict)
  novels     Novel[]

  // The migrations also index btrim(name), alone and after platformId.
  @@index([platformId])
}

model Novel {
  id         Int         @id @default(autoincrement())
  platformId Int
  authorId   Int?
  title      String
  summary    String?     @db.Text
  coverUrl   String?
  status     NovelStatus @default(ONGOING)
  createdAt  DateTime    @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime    @updatedAt @db.Timestamptz(3)
  platform   Platform    @relation(fields: [platformId], references: [id], onDelete: Restrict)
  author     Author?     @relation(fields: [authorId], references: [id], onDelete: SetNull)
  volumes    Volume[]
  chapters   Chapter[]
  tags       NovelTag[]
  illustrations Illustration[]
  illustrationLayout IllustrationLayout?

  @@index([platformId])
  @@index([authorId])
  @@index([updatedAt(sort: Desc), id(sort: Desc)])
}

model Illustration {
  id        Int      @id @default(autoincrement())
  novelId   Int
  url       String   @db.VarChar(2048)
  sha256    String   @db.VarChar(64)
  width     Int
  height    Int
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  novel     Novel    @relation(fields: [novelId], references: [id], onDelete: Cascade)

  @@unique([novelId, sha256])
  @@index([novelId, id])
}

model IllustrationLayout {
  novelId Int @id
  blocks Json
  revision Int @default(1)
  novel Novel @relation(fields: [novelId], references: [id], onDelete: Cascade)
}

model Tag {
  id     Int        @id @default(autoincrement())
  name   String     @unique
  novels NovelTag[]
}

model NovelTag {
  novelId Int
  tagId   Int
  novel   Novel @relation(fields: [novelId], references: [id], onDelete: Cascade)
  tag     Tag   @relation(fields: [tagId], references: [id], onDelete: Restrict)

  @@id([novelId, tagId])
  @@index([tagId])
}

model Volume {
  id        Int       @id @default(autoincrement())
  novelId   Int
  order     Int
  title     String
  createdAt DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @db.Timestamptz(3)
  novel     Novel     @relation(fields: [novelId], references: [id], onDelete: Cascade)
  chapters  Chapter[]

  @@unique([novelId, order])
  @@unique([id, novelId])
}

model Chapter {
  id        Int      @id @default(autoincrement())
  novelId   Int
  volumeId  Int?
  order     Int
  title     String
  content   String   @db.Text
  // Stored generated columns; the migration defines them as GENERATED ALWAYS.
  contentHash   String?  @default(dbgenerated("md5(content)"))
  contentLength Int?     @default(dbgenerated("length(content)"))
  wordCount     Int?     @default(dbgenerated("char_length(regexp_replace(content, '[\\u0009-\\u000D\\u0020\\u00A0\\u1680\\u2000-\\u200A\\u2028\\u2029\\u202F\\u205F\\u3000\\uFEFF]+'::text, ''::text, 'g'::text))"))
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  novel     Novel    @relation(fields: [novelId], references: [id], onDelete: Cascade)
  volume    Volume?  @relation(fields: [volumeId, novelId], references: [id, novelId], onDelete: NoAction)

  @@unique([novelId, order])
  @@index([volumeId, novelId])
}
