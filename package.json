{
  "name": "@albatextus/oauth-database",
  "private": true,
  "packageManager": "pnpm@11.17.0",
  "scripts": {
    "db:format": "prisma format",
    "db:validate": "prisma validate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "db:seed": "go run ./cmd/seed",
    "web:dev": "pnpm --filter @albatextus/oauth-web dev",
    "web:build": "pnpm --filter @albatextus/oauth-web build",
    "web:start": "pnpm --filter @albatextus/oauth-web start",
    "web:typecheck": "pnpm --filter @albatextus/oauth-web typecheck"
  },
  "devDependencies": {
    "prisma": "6.19.0"
  }
}
