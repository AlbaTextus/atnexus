{
  "name": "@albatextus/oauth-database",
  "private": true,
  "packageManager": "pnpm@11.17.0",
  "scripts": {
    "server:dev": "go run ./cmd/server",
    "test:go": "go test ./... && go -C modules/athub test ./...",
    "db:athub:install": "npm --prefix modules/athub ci",
    "db:athub:validate": "npm --prefix modules/athub run db:validate",
    "db:athub:deploy": "npm --prefix modules/athub run db:deploy",
    "db:athub:studio": "npm --prefix modules/athub run db:studio",
    "db:format": "prisma format",
    "db:validate": "prisma validate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "db:seed": "go run ./cmd/seed",
    "web:dev": "pnpm --filter @albatextus/oauth-web dev",
    "web:build": "pnpm --filter @albatextus/oauth-web build",
    "web:start": "pnpm --filter @albatextus/oauth-web start",
    "web:typecheck": "pnpm --filter @albatextus/oauth-web typecheck"
  },
  "devDependencies": {
    "prisma": "6.19.0"
  }
}
