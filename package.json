{
  "name": "@albatextus/atnexus",
  "private": true,
  "packageManager": "pnpm@11.17.0",
  "scripts": {
    "build:linux-amd64": "node scripts/build-linux-amd64.mjs",
    "server:dev": "go run ./cmd/server",
    "test:go": "node scripts/test-go.mjs",
    "db:athub:install": "npm --prefix modules/athub ci",
    "db:athub:validate": "npm --prefix modules/athub run db:validate",
    "db:athub:deploy": "npm --prefix modules/athub run db:deploy",
    "db:athub:studio": "npm --prefix modules/athub run db:studio",
    "db:creatplat:create": "go run ./cmd/migrate-creatplat -create-database",
    "db:creatplat:validate": "prisma validate --schema modules/creatplat/prisma/schema.prisma",
    "db:creatplat:deploy": "prisma migrate deploy --schema modules/creatplat/prisma/schema.prisma",
    "db:creatplat:import": "go run ./cmd/migrate-creatplat",
    "db:creatplat:studio": "prisma studio --schema modules/creatplat/prisma/schema.prisma",
    "db:image:validate": "prisma validate --schema modules/image/prisma/schema.prisma",
    "db:image:deploy": "prisma migrate deploy --schema modules/image/prisma/schema.prisma",
    "db:image:import": "go run ./cmd/migrate-image",
    "db:image:studio": "prisma studio --schema modules/image/prisma/schema.prisma",
    "db:format": "prisma format",
    "db:validate": "prisma validate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "db:seed": "go run ./cmd/seed",
    "web:dev": "pnpm --filter @albatextus/atnexus-web dev",
    "web:build": "pnpm --filter @albatextus/atnexus-web build",
    "web:start": "pnpm --filter @albatextus/atnexus-web start",
    "web:typecheck": "pnpm --filter @albatextus/atnexus-web typecheck"
  },
  "devDependencies": {
    "prisma": "6.19.0"
  }
}
