datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model LegalDocument {
  slug        String   @id @db.VarChar(20)
  title       String   @db.VarChar(100)
  description String   @default("") @db.VarChar(300)
  content     String   @db.Text
  revision    Int      @default(1)
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("legal_documents")
}

model User {
  bio          String              @default("") @db.Text
  numericId    Int                 @unique @default(autoincrement()) @map("numeric_id")
  id           String              @id @default(uuid()) @db.Uuid
  email        String              @unique @db.VarChar(320)
  emailVerified Boolean            @default(false) @map("email_verified")
  profileSetupRequired Boolean     @default(false) @map("profile_setup_required")
  passwordHash String              @map("password_hash") @db.VarChar(255)
  displayName  String?             @map("display_name") @db.VarChar(100)
  avatarSource String              @default("auto") @map("avatar_source") @db.VarChar(40)
  customAvatarUrl String           @default("") @map("custom_avatar_url") @db.VarChar(2048)
  role         String              @default("USER") @db.VarChar(20)
  isActive     Boolean             @default(true) @map("is_active")
  createdAt    DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)
  sessions     UserSession[]
  passkeys     PasskeyCredential[]
  ceremonies   WebAuthnCeremony[]
  codes        AuthorizationCode[]
  tokens       OAuthToken[]
  applications OAuthClient[]       @relation("ApplicationOwner")
  externalIdentities ExternalIdentity[]
  externalLoginFlows ExternalLoginFlow[]
  consentRequests OAuthConsentRequest[]

  @@map("users")
}

model EmailChallenge {
  id            String   @id @db.Uuid
  purpose       String   @db.VarChar(20)
  email         String   @db.VarChar(320)
  actor         String   @db.VarChar(128)
  previousEmail String   @default("") @map("previous_email") @db.VarChar(320)
  codeHash      String   @map("code_hash") @db.Char(64)
  attempts      Int      @default(0)
  ready         Boolean  @default(false)
  expiresAt     DateTime @map("expires_at") @db.Timestamptz(6)

  @@unique([purpose, email, actor])
  @@index([expiresAt])
  @@map("email_challenges")
}

model EmailRateLimit {
  key       String   @id @db.Char(64)
  count     Int
  expiresAt DateTime @map("expires_at") @db.Timestamptz(6)

  @@index([expiresAt])
  @@map("email_rate_limits")
}

model ExternalIdentity {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  provider    String   @db.VarChar(40)
  subject     String   @db.VarChar(255)
  email       String   @default("") @db.VarChar(320)
  displayName String   @default("") @map("display_name") @db.VarChar(100)
  avatarUrl   String   @default("") @map("avatar_url") @db.VarChar(2048)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, subject])
  @@unique([userId, provider])
  @@map("external_identities")
}

model ExternalLoginFlow {
  stateHash          String   @id @map("state_hash") @db.Char(64)
  browserHash        String   @map("browser_hash") @db.Char(64)
  provider           String   @db.VarChar(40)
  verifierCiphertext String   @map("verifier_ciphertext") @db.Text
  returnTo           String   @map("return_to") @db.Text
  userId             String?  @map("user_id") @db.Uuid
  sessionHash        String   @default("") @map("session_hash") @db.Char(64)
  expiresAt          DateTime @map("expires_at") @db.Timestamptz(6)
  user               User?    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
  @@map("external_login_flows")
}

model PasskeyCredential {
  id              String    @id @default(uuid()) @db.Uuid
  userId          String    @map("user_id") @db.Uuid
  credentialId    String    @unique @map("credential_id") @db.Text
  publicKey       Bytes     @map("public_key")
  attestationType String    @map("attestation_type") @db.VarChar(50)
  transports      String[]  @default([])
  signCount       BigInt    @default(0) @map("sign_count")
  userPresent     Boolean   @default(true) @map("user_present")
  userVerified    Boolean   @default(false) @map("user_verified")
  backupEligible  Boolean   @default(false) @map("backup_eligible")
  backupState     Boolean   @default(false) @map("backup_state")
  name            String    @default("通行密钥") @db.VarChar(100)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  lastUsedAt      DateTime? @map("last_used_at") @db.Timestamptz(6)
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("passkey_credentials")
}

model WebAuthnCeremony {
  id          String    @id @default(uuid()) @db.Uuid
  tokenHash   String    @unique @map("token_hash") @db.Char(64)
  userId      String?   @map("user_id") @db.Uuid
  kind        String    @db.VarChar(20)
  sessionData Json      @map("session_data")
  expiresAt   DateTime  @map("expires_at") @db.Timestamptz(6)
  usedAt      DateTime? @map("used_at") @db.Timestamptz(6)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  user        User?     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("webauthn_ceremonies")
}

model SiteMaintenance {
  id        Int      @id @default(1)
  enabled   Boolean  @default(false)
  updatedBy String?  @map("updated_by") @db.Uuid
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  @@map("site_maintenance")
}

model UserSession {
  id        String    @id @default(uuid()) @db.Uuid
  tokenHash String    @unique @map("token_hash") @db.Char(64)
  userId    String    @map("user_id") @db.Uuid
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("user_sessions")
}

model OAuthClient {
  id                String              @id @db.VarChar(100)
  name              String              @db.VarChar(100)
  ownerId           String?             @map("owner_id") @db.Uuid
  homepageUrl       String              @default("") @map("homepage_url") @db.VarChar(2048)
  description       String              @default("") @db.VarChar(1000)
  iconUrl           String              @default("") @map("icon_url") @db.VarChar(2048)
  minimumRole       String              @default("USER") @map("minimum_role") @db.VarChar(20)
  secretHash        String?             @map("secret_hash") @db.VarChar(255)
  secretCiphertext  String?             @map("secret_ciphertext") @db.Text
  redirectUris      String[]            @default([]) @map("redirect_uris")
  allowedGrantTypes String[]            @default([]) @map("allowed_grant_types")
  allowedScopes     String[]            @default([]) @map("allowed_scopes")
  accessTokenTtl    Int                 @default(900) @map("access_token_ttl")
  refreshTokenTtl   Int                 @default(2592000) @map("refresh_token_ttl")
  isActive          Boolean             @default(true) @map("is_active")
  createdAt         DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)
  codes             AuthorizationCode[]
  tokens            OAuthToken[]
  owner             User?               @relation("ApplicationOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  consentRequests   OAuthConsentRequest[]

  @@index([ownerId])
  @@map("oauth_clients")
}

model OAuthConsentRequest {
  tokenHash     String   @id @map("token_hash") @db.Char(64)
  userId        String   @map("user_id") @db.Uuid
  clientId      String   @map("client_id") @db.VarChar(100)
  sessionHash   String   @map("session_hash") @db.Char(64)
  requestData   Json     @map("request_data")
  clientVersion DateTime @map("client_version") @db.Timestamptz(6)
  expiresAt     DateTime @map("expires_at") @db.Timestamptz(6)
  user          User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  client        OAuthClient @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
  @@index([userId])
  @@map("oauth_consent_requests")
}

model AuthorizationCode {
  id                  String      @id @default(uuid()) @db.Uuid
  codeHash            String      @unique @map("code_hash") @db.Char(64)
  clientId            String      @map("client_id") @db.VarChar(100)
  userId              String      @map("user_id") @db.Uuid
  redirectUri         String      @map("redirect_uri") @db.Text
  scopes              String[]    @default([])
  codeChallenge       String?     @map("code_challenge") @db.VarChar(128)
  codeChallengeMethod String?     @map("code_challenge_method") @db.VarChar(10)
  expiresAt           DateTime    @map("expires_at") @db.Timestamptz(6)
  usedAt              DateTime?   @map("used_at") @db.Timestamptz(6)
  createdAt           DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  client              OAuthClient @relation(fields: [clientId], references: [id], onDelete: Cascade)
  user                User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([clientId])
  @@index([userId])
  @@index([expiresAt])
  @@map("authorization_codes")
}

model OAuthToken {
  id               String      @id @default(uuid()) @db.Uuid
  accessTokenHash  String      @unique @map("access_token_hash") @db.Char(64)
  refreshTokenHash String?     @unique @map("refresh_token_hash") @db.Char(64)
  clientId         String      @map("client_id") @db.VarChar(100)
  userId           String?     @map("user_id") @db.Uuid
  scopes           String[]    @default([])
  accessExpiresAt  DateTime    @map("access_expires_at") @db.Timestamptz(6)
  refreshExpiresAt DateTime?   @map("refresh_expires_at") @db.Timestamptz(6)
  revokedAt        DateTime?   @map("revoked_at") @db.Timestamptz(6)
  createdAt        DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  client           OAuthClient @relation(fields: [clientId], references: [id], onDelete: Cascade)
  user             User?       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([clientId])
  @@index([userId])
  @@index([accessExpiresAt])
  @@index([refreshExpiresAt])
  @@map("oauth_tokens")
}
