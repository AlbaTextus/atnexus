# syntax=docker/dockerfile:1
FROM node:22-alpine

WORKDIR /app
RUN corepack enable

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY web/package.json ./web/package.json
RUN pnpm install --frozen-lockfile --ignore-scripts

COPY web ./web
ARG OAUTH_BACKEND_URL=http://atnexus:8010
ARG CREATPLAT_BACKEND_URL=http://atnexus:8010
ENV CREATPLAT_BACKEND_URL=$CREATPLAT_BACKEND_URL
ARG NEXT_PUBLIC_WIKI_URL=http://localhost:3200
ENV OAUTH_BACKEND_URL=$OAUTH_BACKEND_URL
ENV NEXT_PUBLIC_WIKI_URL=$NEXT_PUBLIC_WIKI_URL
ARG NEXT_PUBLIC_CREDIT_URL=http://localhost:3300
ENV NEXT_PUBLIC_CREDIT_URL=$NEXT_PUBLIC_CREDIT_URL
ARG NEXT_PUBLIC_ATHUB_API_URL=http://localhost:8010
ENV NEXT_PUBLIC_ATHUB_API_URL=$NEXT_PUBLIC_ATHUB_API_URL
ARG NEXT_PUBLIC_CREATPLAT_API_URL=http://localhost:8010
ENV NEXT_PUBLIC_CREATPLAT_API_URL=$NEXT_PUBLIC_CREATPLAT_API_URL
RUN pnpm web:build

EXPOSE 3288
CMD ["pnpm", "web:start"]
