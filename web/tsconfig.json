{
  "compilerOptions": {
    "target": "ES2017",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": false,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./*"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "temp/local-services/types/**/*.ts",
    "temp/local-services/dev/types/**/*.ts",
    "temp/next-imgbed/types/**/*.ts",
    "temp/next-imgbed/dev/types/**/*.ts",
    "temp/next-athub-login/types/**/*.ts",
    "temp/next-athub-login/dev/types/**/*.ts",
    "temp/dev-3000-20261003/types/**/*.ts",
    "temp/dev-3000-20261003/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "temp",
    "temps",
    "release"
  ]
}
